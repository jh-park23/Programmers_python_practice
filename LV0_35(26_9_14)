def solution(ineq, eq, n, m):
    op = ineq + eq
    if op == '>=':
        if n >= m:
            answer = 1
        else:
            answer = 0
    elif op == '<=':
        if n <= m:
            answer = 1
        else:
            answer = 0
    elif op == '>!':
        if n > m:
            answer = 1
        else:
            answer = 0
    elif op == '<!':
        if n < m:
            answer = 1
        else:
            answer = 0
    return answer