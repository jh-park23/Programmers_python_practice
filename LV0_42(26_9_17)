def solution(num_list):
    answer = []
    length = len(num_list)
    if num_list[length - 1] > num_list[length - 2]:
        for i in range(length):
            answer.append(num_list[i])
        answer.append(num_list[length - 1] - num_list[length - 2])
    else:
        for i in range(length):
            answer.append(num_list[i])
        answer.append(num_list[length - 1]*2)
    
    return answer