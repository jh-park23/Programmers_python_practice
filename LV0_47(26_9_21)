def solution(arr, queries):
    answer = []
    length = len(queries)
    for n in range(length):
        first_idx = queries[n][0]
        last_idx = queries[n][1]
        muti_num = queries[n][2]
        for i in range(first_idx, last_idx +1):
            if i % muti_num == 0:
                arr[i] += 1
    answer = arr
    return answer